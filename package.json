{
  "name": "@inzumer/milimon-emails",
  "version": "0.2.0",
  "description": "Milimon transactional email templates (account welcome, account deleted), in Spanish and English",
  "license": "MIT",
  "author": "Nahuel Zamuner <inzumer@gmail.com>",
  "homepage": "https://github.com/inzumer/milimon-emails-react#readme",
  "bugs": {
    "url": "https://github.com/inzumer/milimon-emails-react/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/inzumer/milimon-emails-react.git"
  },
  "keywords": [
    "email",
    "react-email",
    "milimon"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@inzumer/email": "^0.2.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@inzumer/eslint": "^1.1.0",
    "@inzumer/prettier": "^1.0.0",
    "@inzumer/tsconfig": "^1.0.0",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^9.39.5",
    "prettier": "^3.9.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "storybook": "^10.6.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.2"
  },
  "pnpm": {
    "overrides": {
      "esbuild@>=0.27.3 <0.28.1": "^0.28.1",
      "source-map-js@<1.2.2": "^1.2.2"
    }
  }
}
